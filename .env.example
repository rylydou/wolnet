# Every variable here has a working default (see `src/env.ts`), so a fresh clone runs without a
# `.env` file at all. Copy this to `.env` only to override something.

# Whether to run pending database migrations on startup.
WOL_DB_AUTO_MIGRATE=true

# Where persistent state (the SQLite database) lives. Relative paths resolve against the project
# root; the Docker image sets this to `/data`, which is a volume.
WOL_DATA_DIR=data
