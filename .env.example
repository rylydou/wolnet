# Every setting has a default, so WolNet runs without a `.env` file. Copy this to `.env` only to change one.
# See "Settings" in README.md.

# The port WolNet listens on.
PORT=8778

# Where the database is kept. Relative paths start from the project folder.
WOL_DATA_DIR=data

# Update the database to the latest version on start.
WOL_DB_AUTO_MIGRATE=true
